# copy to .env : cp .env.example .env
POSTGRES_USER=aqua
POSTGRES_PASSWORD=aqua
POSTGRES_DB=aquatesseract
POSTGRES_PORT=5432
SERVER_PORT=4000
CLIENT_PORT=5173
# folder with run folders (see docs/DATA_CONTRACT.md)
RESULTS_DIR=./results
# Constructed from Postgres vars; override if using external DB
DATABASE_URL=postgres://aqua:aqua@localhost:5432/aquatesseract
# Protect /admin/rescan endpoint (leave blank to disable)
ADMIN_TOKEN=changeme
